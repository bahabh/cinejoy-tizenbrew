{
  "name": "cinejoy-tizenbrew",
  "version": "1.0.0",
  "description": "Cinejoy web app for Samsung TVs using TizenBrew",
  "packageType": "app",
  "appName": "Cinejoy",
  "appPath": "app/index.html",
  "keys": [
    "ColorF0Red",
    "ColorF1Green",
    "ColorF2Yellow",
    "ColorF3Blue",
    "MediaPlay",
    "MediaPause",
    "MediaPlayPause",
    "MediaStop",
    "MediaFastForward",
    "MediaRewind",
    "MediaTrackPrevious",
    "MediaTrackNext"
  ],
  "evaluateScriptOnDocumentStart": false
}

